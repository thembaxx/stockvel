# Migration credentials should belong to a separate database owner.
DATABASE_URL=postgresql://stokvel_app:change-me@localhost:5432/stokvelos
MIGRATION_DATABASE_URL=postgresql://stokvel_owner:change-me@localhost:5432/stokvelos
# Neon Auth (requires managed Auth enabled in Neon Console). Never expose this secret in client bundles.
NEON_AUTH_BASE_URL=https://example.neonauth.neon.tech
NEON_AUTH_COOKIE_SECRET=replace-with-32-or-more-random-characters
# Financial API remains disabled pending audited RLS/grant provisioning.
# Public canonical origin, not a secret. Set the custom domain here when it is connected.
SITE_URL=https://stockvel-seven.vercel.app
